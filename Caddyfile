# Free automatic HTTPS for JupyterHub via Caddy + Let's Encrypt.
# Domain is a free sslip.io name that resolves to this VPS public IP.
# Port 80 is occupied on this host, so we disable the HTTP redirect and
# let Caddy obtain certs over TLS-ALPN-01 on port 443 only.
{
	auto_https disable_redirects
	http_port 8080
	email r_boucheraine@estin.dz
}

104.248.22.193.sslip.io {
	# Tout passe par JupyterHub. Le Hub tourne maintenant dans Kubernetes
	# (Deployment jupyterhub, Service NodePort 30080). Sur un nœud kubeadm
	# unique, le NodePort écoute sur 127.0.0.1:30080.
	# Pour kind, exposez le service avec :
	#   kubectl -n saiep-system port-forward svc/jupyterhub 30080:8000
	reverse_proxy 127.0.0.1:30080
}
