# Copy to secrets.env and fill in real values (secrets.env is gitignored).
# start-hub.sh sources this before launching JupyterHub.
# Generate tokens with:  openssl rand -hex 32
export SAIEP_PROMETHEUS_TOKEN=replace-with-a-random-hex-token

# --- Scheduling Layer (Argo jobs at /hub/jobs) — optional ---
# kubeconfig for the saiep-hub ServiceAccount, written by:
#   python -m saiep_cli  ->  "Generate hub kubeconfig"
# export SAIEP_KUBECONFIG=$HOME/.saiep/hub-kubeconfig
# Fallback only: tenant egress normally follows the live default/kubernetes
# EndpointSlice. Used if the hub cannot read it (comma-separated CIDRs).
# export SAIEP_API_SERVER_CIDR=172.18.0.2/32
# export SAIEP_API_SERVER_PORT=6443
# MinIO store (job logs after pod GC, decision records) — values printed by the
# same CLI option from ~/.saiep/minio.json. Executor keys are required for jobs.
# export SAIEP_MINIO_ENDPOINT=http://<saiep-minio ClusterIP>:9000
# export SAIEP_MINIO_ACCESS_KEY=saiep-hub
# export SAIEP_MINIO_SECRET_KEY=...
# export SAIEP_MINIO_EXECUTOR_ACCESS_KEY=argo-executor
# export SAIEP_MINIO_EXECUTOR_SECRET_KEY=...
# Optional AI optimisation module (advisory, 2 s timeout)
# export SAIEP_AI_URL=http://ai-module.saiep-system:8080
